# Production: https://ipcm.tsucpgs.com.ng (used in emails, QR codes and Paystack return links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# development | staging | production (placeholder tags hidden in production)
NEXT_PUBLIC_APP_ENV=development
# true = open the student portal with demo data for design review (Phase 0 only)
NEXT_PUBLIC_PORTAL_PREVIEW=true
NEXT_PUBLIC_SUPABASE_URL=https://qvromyptbhzkziultlpd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never commit or expose
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Email (Resend). Without RESEND_API_KEY emails are logged as "not sent" and nothing breaks.
RESEND_API_KEY=
EMAIL_FROM="IPCM Admissions <admissions@ipcm.tsucpgs.com.ng>"
EMAIL_REPLY_TO=
# Any long random string; Vercel sends it to the daily reminder job
CRON_SECRET=
SENTRY_DSN=
